{
  "name": "tabs-exporter",
  "version": "1.2.0",
  "description": "SLinks - 一款可將瀏覽器分頁匯出為 CSV / TXT，或上傳到 Google Drive 的 Chrome / Brave 擴充功能",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "npm run clean && rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/chrome": "^0.0.268",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.5",
    "rollup": "^4.9.6",
    "rollup-plugin-copy": "^3.5.0",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.4.0",
    "vitest": "^2.0.5"
  }
}
