{
  "name": "tabs-exporter",
  "version": "1.1.0",
  "description": "SLinks - 一款可將瀏覽器分頁匯出為 CSV / TXT，或上傳到 Google Drive 的 Chrome / Brave 擴充功能",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "npm run clean && rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/chrome": "^0.0.268",
    "rimraf": "^5.0.5",
    "rollup": "^4.9.6",
    "rollup-plugin-copy": "^3.5.0",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  }
}
